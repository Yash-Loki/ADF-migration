{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "VisionBoard-DEV-ING"
		},
		"AzureBlobStorageSink_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorageSink'"
		},
		"AzureDataLakeStorageSource_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorageSource'"
		},
		"LS_SINK1_CSV_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_SINK1_CSV'"
		},
		"AzureDataLakeStorageSource_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://lokisourcesa.dfs.core.windows.net/"
		},
		"LS_SINK1_CSV_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://lokisinksa.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "VisionBoard-DEV-ING_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorageSink_connectionString": {
						"value": "[parameters('AzureBlobStorageSink_connectionString')]"
					},
					"AzureDataLakeStorageSource_accountKey": {
						"value": "[parameters('AzureDataLakeStorageSource_accountKey')]"
					},
					"LS_SINK1_CSV_accountKey": {
						"value": "[parameters('LS_SINK1_CSV_accountKey')]"
					},
					"AzureDataLakeStorageSource_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorageSource_properties_typeProperties_url')]"
					},
					"LS_SINK1_CSV_properties_typeProperties_url": {
						"value": "[parameters('LS_SINK1_CSV_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}