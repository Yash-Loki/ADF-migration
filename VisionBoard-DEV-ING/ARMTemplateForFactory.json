								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-11-03T10:42:54Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_Source_CSV')]",
				"[concat(variables('factoryId'), '/datasets/Parquet1')]"
			]
